<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ServiceManagementActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="30dp">

            <RelativeLayout
                android:id="@+id/relativeLayout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:src="@drawable/ic_baseline_arrow_back_24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@id/back"
                    android:text="Service management"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="15dp"
                    android:src="@drawable/notification" />


            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/serviceStatusCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintTop_toBottomOf="@id/relativeLayout">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/home"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvServiceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No patient will be allowed to book consultation, when shutdown mode is turn on."
                        android:textSize="16sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_toLeftOf="@id/switchStatus"
                        android:layout_marginRight="10dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                    <Switch
                        android:id="@+id/switchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="15dp"
                        android:layout_marginRight="15dp"
                        android:textOff="OFF"
                        android:textOn="ON"
                        android:checked="false"/>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/amountCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintTop_toBottomOf="@id/serviceStatusCardView">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/home"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tvPendingAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Amount : "
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="15dp" />

                    <TextView
                        android:id="@+id/tvDepositAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deposit Amount : "
                        android:textSize="18sp"
                        android:layout_below="@id/tvPendingAmount"
                        android:textColor="@color/white"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="15dp" />

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Amount : "
                        android:textSize="18sp"
                        android:layout_below="@id/tvDepositAmount"
                        android:textColor="@color/white"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="15dp" />

                    <TextView
                        android:id="@+id/pendingAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/tvPendingAmount"
                        android:text="2800"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="15dp" />

                    <TextView
                        android:id="@+id/depositAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2500"
                        android:textSize="18sp"
                        android:layout_below="@id/tvPendingAmount"
                        android:layout_toRightOf="@id/tvDepositAmount"
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="15dp" />

                    <TextView
                        android:id="@+id/totalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5300"
                        android:layout_toRightOf="@id/tvTotalAmount"
                        android:textSize="18sp"
                        android:layout_below="@id/tvDepositAmount"
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="15dp" />


                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/msgCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintTop_toBottomOf="@id/amountCardView">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/home">

                    <ImageView
                        android:id="@+id/msgImg"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_margin="15dp"
                        android:src="@drawable/ic_baseline_message_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_toRightOf="@id/msgImg"
                        android:text="Send Message"
                        android:textColor="@color/grey"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMsgPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/msgImg"
                        android:layout_marginLeft="22dp"
                        android:layout_marginBottom="15dp"
                        android:text="Service Price"
                        android:textColor="@color/grey"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/edtMsgPrice"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_below="@id/txtMsgPrice"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/profile_edt_bg"
                        android:inputType="number"
                        android:paddingLeft="15dp"
                        android:textColor="@color/dark_grey" />

                    <TextView
                        android:id="@+id/txtMsgTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/edtMsgPrice"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="22dp"
                        android:layout_marginBottom="15dp"
                        android:text="Rate per 30 minutes"
                        android:textColor="@color/grey" />

                    <TextView
                        android:id="@+id/txtMsgDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtMsgTime"
                        android:layout_marginLeft="22dp"
                        android:layout_marginBottom="15dp"
                        android:text="Description"
                        android:textColor="@color/grey"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/edtMsgDesc"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_below="@id/txtMsgDesc"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/profile_edt_bg"
                        android:gravity="top"
                        android:paddingLeft="15dp"
                        android:paddingTop="10dp"
                        android:textColor="@color/dark_grey" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/callCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintTop_toBottomOf="@id/msgCardView">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/home">

                    <ImageView
                        android:id="@+id/callImg"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_margin="15dp"
                        android:src="@drawable/ic_baseline_call_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_toRightOf="@id/callImg"
                        android:text="Video Call"
                        android:textColor="@color/grey"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCallPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/callImg"
                        android:layout_marginLeft="22dp"
                        android:layout_marginBottom="15dp"
                        android:text="Service Price"
                        android:textColor="@color/grey"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/edtCallPrice"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_below="@id/txtCallPrice"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/profile_edt_bg"
                        android:inputType="number"
                        android:paddingLeft="15dp"
                        android:textColor="@color/dark_grey" />

                    <TextView
                        android:id="@+id/txtCallTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/edtCallPrice"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="22dp"
                        android:layout_marginBottom="15dp"
                        android:text="Rate per 30 minutes"
                        android:textColor="@color/grey" />

                    <TextView
                        android:id="@+id/txtCallDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtCallTime"
                        android:layout_marginLeft="22dp"
                        android:layout_marginBottom="15dp"
                        android:text="Description"
                        android:textColor="@color/grey"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/edtCallDesc"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_below="@id/txtCallDesc"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/profile_edt_bg"
                        android:gravity="top"
                        android:paddingLeft="15dp"
                        android:paddingTop="10dp"
                        android:textColor="@color/dark_grey" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <android.widget.Button
                android:id="@+id/btnTimeSlot"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/line_bg"
                android:text="Manage time slot"
                android:textColor="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/callCardView" />

            <android.widget.Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:background="@drawable/line_bg"
                android:text="Save"
                android:textColor="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/btnTimeSlot" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>